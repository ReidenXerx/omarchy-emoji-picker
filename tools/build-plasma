#!/usr/bin/env bash
# Assemble the Plasma widget: the plasma/ package, EmojiModel.js, the data turned into a JS module (a widget cannot
# read a local file itself), the GIF helper and plasma-type, into dist/app.duduphudu.emoji-picker and
# dist/emoji-picker.plasmoid.
set -euo pipefail
root="$(cd "$(dirname "$0")/.." && pwd)"
out="$root/dist/app.duduphudu.emoji-picker"
rm -rf -- "${out:?}" "$root/dist/emoji-picker.plasmoid"
mkdir -p "$out/contents/code/bin"
cp -r "$root/plasma/." "$out/"
cp "$root/EmojiModel.js" "$out/contents/code/"
/usr/bin/python3 -I - "$root/data" "$out/contents/code/EmojiData.js" <<'PY'
import json, pathlib, sys
data, target = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
parts = [".pragma library", "// Generated by tools/build-plasma from data/*.json; see THIRD_PARTY_NOTICES.md."]
for name in ("emoji", "symbols", "kaomoji"):
    doc = json.loads((data / f"{name}.json").read_text(encoding="utf-8"))
    text = json.dumps(doc, ensure_ascii=False, separators=(',', ':'))
    # Valid in JSON, a line break in JavaScript source: written as escapes.
    for code in (0x2028, 0x2029):
        text = text.replace(chr(code), "\\u%04x" % code)
    parts.append(f"var {name.upper()} = {text}")
target.write_text("\n".join(parts) + "\n", encoding="utf-8")
PY
cp "$root/bin/emoji-picker" "$root/bin/plugin_safety.py" "$root/bin/plasma-type" "$out/contents/code/bin/"
cp "$root/LICENSE" "$root/THIRD_PARTY_NOTICES.md" "$out/"
cp -r "$root/LICENSES" "$out/"
chmod 755 "$out/contents/code/bin/emoji-picker" "$out/contents/code/bin/plasma-type"
(cd "$out" && /usr/bin/zip -qr "$root/dist/emoji-picker.plasmoid" .)
echo "$out"
